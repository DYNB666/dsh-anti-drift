{
  "name": "dsh-anti-drift",
  "version": "1.1.0",
  "description": "Anti-hallucination / no-drift / no-repetition guard for DeepSeek Harness. For sharing and study only — no other purpose.",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "anti-hallucination", "guard"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
